# CRUCIBLE_SITE_ADDRESS is ":80" for plain HTTP on this machine, or a domain name (for example
# crucible.mylab.org) for HTTPS. Files in ./local adjust how the certificate is obtained
# (README.md, "Certificates"): global-*.caddy for global options, site-*.caddy for this site.
{
	# The plain-HTTP check below must run before the routing blocks.
	order respond before handle
	import /etc/caddy/local/global-*.caddy
}

{$CRUCIBLE_SITE_ADDRESS}

import /etc/caddy/local/site-*.caddy

# Plain HTTP is for this machine only: API keys and passwords must not cross a network unencrypted.
# CRUCIBLE_HTTP_HOSTS adds names for a proxy in front that already provides HTTPS.
@plain_http_elsewhere {
	protocol http
	not host localhost 127.0.0.1 [::1] {$CRUCIBLE_HTTP_HOSTS}
}
respond @plain_http_elsewhere "Crucible serves plain HTTP only on localhost. Set up HTTPS to reach it from other machines (deploy/compose/README.md)." 421

# Stored files pass through byte for byte, with their length, so downloads can resume.
@compressible not path /{$CRUCIBLE_UPLOAD_BUCKET:crucible-files}/*
encode @compressible zstd gzip

redir /api/v3 /api/v3/ permanent
redir /hub /hub/ permanent

# Sign-in (the OAuth routes, the provider callbacks, the API's own forms, and the routes older Hub
# releases call): small requests only, and a bounded wait for the API, as the Foundry's front door sets.
@sign_in path /api/v3/oauth/* /api/v3/auth/hub/*
handle @sign_in {
	request_body {
		max_size 8KB
	}
	uri strip_prefix /api/v3
	reverse_proxy api:8000 {
		transport http {
			response_header_timeout 20s
		}
	}
}

# The same body limits as the API's own (API_MAX_BODY_MIB, API_MAX_THUMBNAIL_BODY_MIB), refused here
# before they reach it. Files never pass through the API; thumbnails arrive as base64 JSON.
handle_path /api/v3/* {
	@thumbnail path_regexp ^/datasets/[^/]+/thumbnails(/[^/]+)?/?$
	@other not path_regexp ^/datasets/[^/]+/thumbnails(/[^/]+)?/?$
	request_body @thumbnail {
		max_size 20MiB
	}
	request_body @other {
		max_size 10MiB
	}
	reverse_proxy api:8000
}

# The bundled store, for the signed upload and download URLs the API hands out. The store checks
# each URL's signature, so the path and Host reach it unchanged. Clients may send their API key or
# cookies along; neither goes to the store. A downloaded file never runs as a page of this site
# (web.dev, "Securely hosting user data"); current Chrome and Firefox still show PDFs and images.
handle /{$CRUCIBLE_UPLOAD_BUCKET:crucible-files}/* {
	request_header -Authorization
	request_header -Cookie
	header {
		Content-Security-Policy "sandbox; default-src 'none'"
		X-Content-Type-Options nosniff
		Cross-Origin-Resource-Policy same-site
	}
	reverse_proxy seaweedfs:8333
}

# The Hub keeps its /hub prefix. CRUCIBLE_HUB_UPSTREAM is read per request, so an empty value
# (no Hub) needs no other change here.
handle /hub/* {
	@no_hub `{env.CRUCIBLE_HUB_UPSTREAM} == ""`
	respond @no_hub "The Hub is not installed on this server" 404
	reverse_proxy {env.CRUCIBLE_HUB_UPSTREAM}
}

handle {
	respond "Crucible: the API is at /api/v3/" 404
}
