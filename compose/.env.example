# Settings for the Docker Compose bundle. Copy to .env, which Docker Compose reads from this
# directory. Secrets do not belong here: they are files in ./secrets (README.md).
#
# Active lines are the shipped defaults. Commented lines are optional and show the default
# value, or an example where a setting has no default. Apply changes with:
#   docker compose up -d --wait

# ------------------------------------------------------------------------------------------
# Network access (docs/network.md)
#
# Set every value from one column; a mix leaves the server unreachable from other computers.
#
#                          This host only    HTTPS on a network          Behind another proxy
#                          (default)                                     that provides HTTPS
#   CRUCIBLE_SITE_ADDRESS  :80               crucible.mylab.org          :80
#   CRUCIBLE_HTTP_PORT     8080              80                          8080
#   CRUCIBLE_HTTPS_PORT    8443 (unused)     443                         8443 (unused)
#   CRUCIBLE_BIND_ADDRESS  127.0.0.1         0.0.0.0                     address the proxy reaches
#   CRUCIBLE_PUBLIC_URL    unset             https://crucible.mylab.org  https://crucible.mylab.org
#   CRUCIBLE_HTTP_HOSTS    unset             unset                       crucible.mylab.org
#
# HTTPS on a network also needs a certificate (docs/network.md, "Certificates").
# ------------------------------------------------------------------------------------------

# Name the server answers to. ":80" serves plain HTTP; a host name (no https://, no port)
# makes Caddy serve HTTPS for that name.
CRUCIBLE_SITE_ADDRESS=:80

# Host port for plain HTTP.
CRUCIBLE_HTTP_PORT=8080

# Host port for HTTPS.
CRUCIBLE_HTTPS_PORT=8443

# Address the ports listen on: 127.0.0.1 is this host only, 0.0.0.0 every network. Docker
# publishes ports ahead of ufw and firewalld (docs/network.md, "Host firewall").
CRUCIBLE_BIND_ADDRESS=127.0.0.1

# Address clients use, without /api/v3 or a trailing slash. Sign-in and file links contain it.
# Default: http://localhost:<HTTP port>.
# CRUCIBLE_PUBLIC_URL=https://crucible.mylab.org

# Only behind another reverse proxy that provides HTTPS: the names it forwards plain HTTP for.
# CRUCIBLE_HTTP_HOSTS=crucible.mylab.org

# ------------------------------------------------------------------------------------------
# Sign-in (docs/sign_in.md)
# ------------------------------------------------------------------------------------------

# Password sign-in. Set to false when all users sign in through an identity provider.
# CRUCIBLE_AUTH_PASSWORD_ENABLED=true

# Self-registration with a password: closed (administrators create users) or approval
# (users request an account at /api/v3/oauth/register and wait for an administrator).
# CRUCIBLE_AUTH_PASSWORD_REGISTRATION=closed

# With approval, the most accounts that may wait at once; requests are refused while the list
# is full. Every sign-in limit is listed in docs/sign_in_operations.md#limits.
# CRUCIBLE_AUTH_MAX_PENDING_ACCOUNTS=100

# ORCID sign-in. Requires compose.orcid.yaml in COMPOSE_FILE (below), HTTPS, and the client
# secret in secrets/ORCID_CLIENT_SECRET.
# ORCID_CLIENT_ID=APP-XXXXXXXXXXXXXXXX

# ORCID issuer. For the ORCID sandbox: https://sandbox.orcid.org
# ORCID_ISSUER=https://orcid.org

# New ORCID users: open (admitted), approval (wait for an administrator) or closed (refused).
# ORCID_REGISTRATION=open

# Only for an ORCID application registered before 4.0.0 with the redirect address
# <address>/api/v3/auth/hub/callback.
# ORCID_LEGACY_CALLBACK=false

# ------------------------------------------------------------------------------------------
# Server
# ------------------------------------------------------------------------------------------

# API worker processes. Two suit a small group; add more for more simultaneous users.
CRUCIBLE_API_WORKERS=2

# Project identifiers that only an administrator may create or rename: a regular expression
# matched against the whole project_id, ignoring case. Default: none reserved.
# CRUCIBLE_RESERVED_PROJECT_ID_PATTERN=PROP[0-9]{5}

# ------------------------------------------------------------------------------------------
# Optional components
# ------------------------------------------------------------------------------------------

# Compose files to load, separated by colons, in this order. Add compose.hub.yaml for the
# Hub (docs/hub.md) and compose.orcid.yaml for ORCID sign-in (docs/sign_in.md).
# COMPOSE_FILE=compose.yaml:compose.hub.yaml:compose.orcid.yaml

# Where Caddy reaches the Hub, as address:port without http://. Change it only when the Hub
# runs on another host.
# CRUCIBLE_HUB_UPSTREAM=hub:3000

# Name of the Docker network a Hub on this host joins.
# CRUCIBLE_NETWORK=crucible

# ------------------------------------------------------------------------------------------
# File storage (docs/storage.md)
# ------------------------------------------------------------------------------------------

# bundled-storage runs SeaweedFS in this bundle. Remove the line to use an external
# S3-compatible store or Google Cloud Storage, and set the external store settings below.
COMPOSE_PROFILES=bundled-storage

# Bundled store: where its data is kept. Default: a Docker volume. A directory must exist
# beforehand and be owned by uid 1000.
# CRUCIBLE_FILES_DIR=/srv/crucible/files

# External store: s3 for any S3-compatible store, gcs for Google Cloud Storage.
# CRUCIBLE_STORAGE_BACKEND=s3

# External S3 store: its endpoint and region.
# CRUCIBLE_S3_ENDPOINT_URL=https://s3.mylab.org
# CRUCIBLE_S3_REGION=us-east-1

# External S3 store: address clients reach it on, when it differs from the endpoint.
# CRUCIBLE_S3_PUBLIC_URL=https://s3.mylab.org

# Buckets for uploaded files and for the copies of record metadata.
# CRUCIBLE_UPLOAD_BUCKET=crucible-files
# CRUCIBLE_RECORD_BUCKET=crucible-records

# ------------------------------------------------------------------------------------------
# Retention, cleanup and backups (docs/operations.md)
# ------------------------------------------------------------------------------------------

# Days the previous content of a replaced file is kept and can be restored.
# CRUCIBLE_FILE_VERSION_RETENTION_DAYS=14

# Hourly removal of expired file versions and abandoned uploads.
# CRUCIBLE_STORAGE_CLEANUP_ENABLED=true

# Days of sign-in history kept.
# CRUCIBLE_AUTH_EVENT_RETENTION_DAYS=365

# Directory that `docker compose run --rm files-backup` copies the stored files to, under
# files/. Default: ~/crucible-backups.
# CRUCIBLE_BACKUP_DIR=/home/admin/crucible-backups
