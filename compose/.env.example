# Copy to .env and adjust. Docker Compose reads .env from this folder.
# Secrets do not go here: they are files in ./secrets (see README.md).

# --- Who can reach this server (see "Putting it on a network" in README.md) ---
# As shipped, only this machine can: plain HTTP at http://localhost:8080, nothing on any network.
# Port on this machine for plain HTTP (the API is at http://localhost:<port>/api/v3/).
CRUCIBLE_HTTP_PORT=8080

# Port on this machine for HTTPS, used when CRUCIBLE_SITE_ADDRESS is a domain name.
CRUCIBLE_HTTPS_PORT=8443

# To serve other machines, all four change together:
# - the name people use, which makes Caddy serve HTTPS (plain HTTP is refused off localhost);
# - the standard ports;
# - 0.0.0.0 to listen on the network (the default, 127.0.0.1, is this machine only);
# - the address clients use, without /api/v3 or a trailing slash.
CRUCIBLE_SITE_ADDRESS=:80
# CRUCIBLE_SITE_ADDRESS=crucible.mylab.org
# CRUCIBLE_HTTP_PORT=80
# CRUCIBLE_HTTPS_PORT=443
# CRUCIBLE_BIND_ADDRESS=0.0.0.0
# CRUCIBLE_PUBLIC_URL=https://crucible.mylab.org

# Only behind another proxy that already provides HTTPS: the names it forwards plain HTTP for.
# CRUCIBLE_HTTP_HOSTS=crucible.mylab.org

# --- Sign-in (see "Signing in" in README.md) ---
# Passwords are on, for small installations: an administrator adds people and gives each a
# one-time link. Set false when people sign in through a provider instead.
# CRUCIBLE_AUTH_PASSWORD_ENABLED=false
# approval lets people ask for an account at /api/v3/oauth/register, for an administrator to approve.
# CRUCIBLE_AUTH_PASSWORD_REGISTRATION=approval

# API worker processes. Two suit a small group; add more for more simultaneous users.
CRUCIBLE_API_WORKERS=2

# --- File storage (see "File storage" in README.md) ---
# bundled-storage runs SeaweedFS in this bundle. To use another S3-compatible store instead, remove
# it here and set the CRUCIBLE_S3_* and bucket settings below. For a Google Cloud Storage bucket,
# remove it and set CRUCIBLE_STORAGE_BACKEND=gcs and the bucket settings (see README.md).
COMPOSE_PROFILES=bundled-storage
# CRUCIBLE_STORAGE_BACKEND=gcs
# CRUCIBLE_S3_ENDPOINT_URL=https://s3.mylab.org
# The address in signed upload and download URLs; defaults to CRUCIBLE_PUBLIC_URL with the bundled store.
# CRUCIBLE_S3_PUBLIC_URL=https://s3.mylab.org
# CRUCIBLE_S3_REGION=us-east-1
# CRUCIBLE_UPLOAD_BUCKET=crucible-files
# CRUCIBLE_RECORD_BUCKET=crucible-records
# Where the bundled store keeps its data: a Docker volume by default, or a folder on a disk of
# your choice, created beforehand and owned by uid 1000 (see "File storage" in README.md).
# CRUCIBLE_FILES_DIR=/srv/crucible/files
# Days a replaced file's previous content is kept (and can be restored) before it is deleted.
# CRUCIBLE_FILE_VERSION_RETENTION_DAYS=14
# The hourly cleanup of old versions and abandoned uploads; on by default.
# CRUCIBLE_STORAGE_CLEANUP_ENABLED=false
# Where `docker compose run --rm files-backup` puts the copy of the stored files (in files/).
# CRUCIBLE_BACKUP_DIR=/home/admin/crucible-backups

# --- The Hub, and ORCID sign-in (optional; see "Adding the Hub" in README.md) ---
# COMPOSE_FILE=compose.yaml:compose.hub.yaml
# With ORCID as well (needs HTTPS and an ORCID application):
# COMPOSE_FILE=compose.yaml:compose.hub.yaml:compose.orcid.yaml
# ORCID_CLIENT_ID=APP-XXXXXXXXXXXXXXXX
# ORCID_ISSUER=https://sandbox.orcid.org
# closed admits only people an administrator added; approval makes new people wait for one.
# ORCID_REGISTRATION=open
# Only for an ORCID application registered before 4.0.0 with <address>/api/v3/auth/hub/callback:
# ORCID_LEGACY_CALLBACK=true
# Where Caddy finds the Hub, as address:port without http://: hub:3000 on this machine (the default), <address>:3000 on another one.
# CRUCIBLE_HUB_UPSTREAM=hub:3000
# The shared network the Hub joins on this machine.
# CRUCIBLE_NETWORK=crucible
